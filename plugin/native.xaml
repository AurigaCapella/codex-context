<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Context 状态栏" Width="1024" MinWidth="300" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True"
        Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="Manual" ShowActivated="False" ShowInTaskbar="False">
  <Window.Resources>
    <SolidColorBrush x:Key="ThemeText" Color="#EFEDFA"/>
    <SolidColorBrush x:Key="ThemeMuted" Color="#B9B7CF"/>
    <SolidColorBrush x:Key="ThemeControl" Color="#242538"/>
    <SolidColorBrush x:Key="ThemeHover" Color="#45445A"/>
    <SolidColorBrush x:Key="ThemeSelected" Color="#383450"/>
    <SolidColorBrush x:Key="ThemeBorder" Color="#45445C"/>
    <SolidColorBrush x:Key="ThemePanel" Color="#1F2032"/>
    <SolidColorBrush x:Key="ThemeAccent" Color="#DECBFF"/>
    <SolidColorBrush x:Key="ThemeAccentText" Color="#DECBFF"/>
    <SolidColorBrush x:Key="ThemeMetric" Color="#DDD6FF"/>
    <SolidColorBrush x:Key="ThemeTrack" Color="#554D68"/>
    <SolidColorBrush x:Key="RibbonBackground" Color="#DC1A1B2E"/>
    <SolidColorBrush x:Key="InspectorBackground" Color="#F41A1B2E"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value=".42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="Padding" Value="7"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{DynamicResource ThemeControl}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1" Padding="9,5" Margin="0,0,3,0" CornerRadius="5,5,0,0">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/>
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeSelected}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RibbonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="5,2"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="MinWidth" Value="23"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="Metric" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="3,2"/>
      <Setter Property="Height" Value="20"/>
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <DataTemplate x:Key="InspectorTemplate">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="InspectorCaption" DockPanel.Dock="Top" Text="正在连接本机会话" FontSize="11"
                   Foreground="{DynamicResource ThemeMuted}" Margin="3,0,3,6" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="InspectorStatus" DockPanel.Dock="Bottom" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="3,4,3,0"
                   Text="连接本机会话日志" TextTrimming="CharacterEllipsis"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="Threads" DisplayMemberPath="Label" SelectedValuePath="Id"
                    IsTextSearchEnabled="True" AutomationProperties.Name="选择本机会话" Margin="0,0,5,0"/>
          <CheckBox x:Name="FollowChat" Grid.Column="1" Content="跟随聊天" Foreground="{DynamicResource ThemeText}" IsChecked="True" VerticalAlignment="Center"
                    Margin="3,0,6,0" ToolTip="跟随当前 Codex 聊天，遇到重名时保留当前选择"/>
          <Button x:Name="OpenCodex" Grid.Column="2" Content="切到会话 ↗" IsEnabled="False"/>
        </Grid>
        <TabControl x:Name="InspectionTabs" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}">
          <TabItem Header="回复与分支">
            <DockPanel Margin="6">
              <ListBox x:Name="Turns" DockPanel.Dock="Top" Height="177" AutomationProperties.Name="回复轮次">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="1"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="6,4" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource ThemeMuted}"/>
                        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Margin="0,2,0,3"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Usage}" FontSize="11" Foreground="{DynamicResource ThemeMetric}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Content="分支 ↗" Tag="{Binding Id}" IsEnabled="{Binding CanFork}"
                                  AutomationProperties.Name="{Binding BranchLabel}" FontSize="11"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBox x:Name="TurnMessage" Margin="0,6,0,0" IsReadOnly="True" AutomationProperties.Name="轮次回复"/>
            </DockPanel>
          </TabItem>
          <TabItem Header="上下文">
            <DockPanel Margin="6">
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button x:Name="Instructions" Content="会话指令快照" IsEnabled="False"/>
                <Button x:Name="CustomInstructions" Content="配置的指令文件" IsEnabled="False"/>
              </WrapPanel>
              <TextBox x:Name="ModelDetails" IsReadOnly="True" AutomationProperties.Name="模型与上下文"/>
            </DockPanel>
          </TabItem>
          <TabItem Header="工具调用">
            <DockPanel Margin="6">
              <ListBox x:Name="Calls" DockPanel.Dock="Top" DisplayMemberPath="Label" Height="100" AutomationProperties.Name="工具调用列表"/>
              <Button x:Name="FullCall" DockPanel.Dock="Bottom" Content="查看完整输出" IsEnabled="False"
                      HorizontalAlignment="Left" Margin="0,6,0,0"/>
              <TextBox x:Name="CallDetails" Margin="0,6,0,0" IsReadOnly="True" AutomationProperties.Name="调用参数和结果"/>
            </DockPanel>
          </TabItem>
          <TabItem Header="Schema">
            <DockPanel Margin="6">
              <Button x:Name="RefreshMcp" DockPanel.Dock="Top" Content="查询已配置 MCP 的 Schema" IsEnabled="False"
                      HorizontalAlignment="Left" Margin="0,0,0,6"/>
              <TextBlock x:Name="SchemaStatus" DockPanel.Dock="Top" Foreground="{DynamicResource ThemeMuted}" Margin="0,0,0,6"
                         Text="以下为会话留存的 Schema。" TextWrapping="Wrap"/>
              <ListBox x:Name="Schemas" DockPanel.Dock="Top" Height="100" AutomationProperties.Name="工具 Schema 列表"/>
              <TextBox x:Name="SchemaDetails" Margin="0,6,0,0" IsReadOnly="True" AutomationProperties.Name="工具 Schema"/>
            </DockPanel>
          </TabItem>
          <TabItem Header="请求步">
            <DockPanel Margin="6">
              <ListBox x:Name="Steps" DockPanel.Dock="Top" DisplayMemberPath="Label" Height="100" AutomationProperties.Name="模型请求步列表"/>
              <Button x:Name="RequestContext" DockPanel.Dock="Bottom" Content="请求指令与 Schema" IsEnabled="False"
                      HorizontalAlignment="Left" Margin="0,6,0,0"/>
              <TextBox x:Name="StepDetails" Margin="0,6,0,0" IsReadOnly="True" AutomationProperties.Name="单步请求和上游模型"/>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="Shell" BorderThickness="1" CornerRadius="8"
          BorderBrush="{DynamicResource ThemeBorder}" Background="{DynamicResource RibbonBackground}">
    <DockPanel LastChildFill="True">
      <Grid DockPanel.Dock="Top" Margin="10,4,7,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="DragArea" Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center" Cursor="SizeAll">
          <StackPanel.ToolTip>
            <StackPanel>
              <TextBlock Text="{Binding ToolTip, ElementName=ThreadCaption}"/>
              <TextBlock Text="{Binding Text, ElementName=Status}"/>
            </StackPanel>
          </StackPanel.ToolTip>
          <TextBlock Text="◆" Foreground="{DynamicResource ThemeAccent}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="Codex Context" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Expand" Style="{StaticResource RibbonButton}" Content="展开" AutomationProperties.Name="检查面板"/>
          <Button x:Name="Dock" Style="{StaticResource RibbonButton}" Content="锁定" ToolTip="锁定在主显示器顶部或解除锁定" AutomationProperties.Name="切换桌面顶部锁定"/>
          <Button x:Name="Hide" Style="{StaticResource RibbonButton}" Content="隐藏"
                  ToolTip="隐藏状态栏，从 Codex Context 入口再次打开" AutomationProperties.Name="隐藏状态栏"/>
          <Button x:Name="CloseWindow" Style="{StaticResource RibbonButton}" Content="×" FontSize="15" ToolTip="关闭状态栏" AutomationProperties.Name="关闭 Codex Context"/>
        </StackPanel>
        <WrapPanel x:Name="Metrics" Grid.Column="1" Margin="4,0" VerticalAlignment="Center" HorizontalAlignment="Center">
          <StackPanel Style="{StaticResource Metric}" TextElement.Foreground="{DynamicResource ThemeMetric}">
            <TextBlock Style="{StaticResource MetricLabel}" Text="轮/步" ToolTip="聊天轮次 / 模型请求步数"/>
            <TextBlock x:Name="Rounds" Text="—" Style="{StaticResource MetricValue}"/>
          </StackPanel>
          <StackPanel Style="{StaticResource Metric}" TextElement.Foreground="{DynamicResource ThemeMetric}">
            <TextBlock Style="{StaticResource MetricLabel}" Text="TPS"/>
            <TextBlock x:Name="Speed" Text="—" Style="{StaticResource MetricValue}"/>
          </StackPanel>
          <StackPanel Style="{StaticResource Metric}" TextElement.Foreground="{DynamicResource ThemeMetric}">
            <TextBlock x:Name="FirstTokenLabel" Style="{StaticResource MetricLabel}" Text="TTFT"/>
            <TextBlock x:Name="FirstToken" Text="—" Style="{StaticResource MetricValue}"/>
          </StackPanel>
          <StackPanel Style="{StaticResource Metric}" TextElement.Foreground="{DynamicResource ThemeMetric}">
            <TextBlock Style="{StaticResource MetricLabel}" Text="Token" ToolTip="累计 Token 用量"/>
            <TextBlock x:Name="Tokens" Text="—" Style="{StaticResource MetricValue}"/>
          </StackPanel>
          <StackPanel Style="{StaticResource Metric}" TextElement.Foreground="{DynamicResource ThemeMetric}">
            <TextBlock Style="{StaticResource MetricLabel}" Text="缓存" ToolTip="累计输入 Token 的缓存命中率"/>
            <TextBlock x:Name="Cache" Text="—" Style="{StaticResource MetricValue}"/>
          </StackPanel>
          <StackPanel Style="{StaticResource Metric}" TextElement.Foreground="{DynamicResource ThemeMetric}">
            <TextBlock x:Name="CostLabel" Style="{StaticResource MetricLabel}" Text="估费" ToolTip="API 估算费用，单位 USD"/>
            <TextBlock x:Name="Cost" Text="—" Style="{StaticResource MetricValue}"/>
          </StackPanel>
          <Grid Margin="3,2" Height="20" TextElement.Foreground="{DynamicResource ThemeAccentText}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource MetricLabel}" Text="上下文"/>
              <TextBlock x:Name="ContextSize" Text="—" Style="{StaticResource MetricValue}"/>
            </StackPanel>
            <ProgressBar x:Name="ContextProgress" Height="2" Maximum="100" VerticalAlignment="Bottom"
                         Background="{DynamicResource ThemeTrack}" Foreground="{DynamicResource ThemeAccent}" AutomationProperties.Name="上下文占用">
              <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                  <Grid x:Name="PART_Track" Background="{TemplateBinding Background}">
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                  </Grid>
                </ControlTemplate>
              </ProgressBar.Template>
            </ProgressBar>
          </Grid>
          <StackPanel Style="{StaticResource Metric}" TextElement.Foreground="{DynamicResource ThemeText}">
            <TextBlock x:Name="RunState" Text="待连接" Style="{StaticResource MetricValue}" ToolTip="当前轮次状态"/>
          </StackPanel>
        </WrapPanel>
      </Grid>
      <TextBlock x:Name="ThreadCaption" Text="正在连接本机会话" Visibility="Collapsed"/>
      <TextBlock x:Name="Status" Text="连接本机会话日志" Visibility="Collapsed"/>
      <ContentControl x:Name="Inspector" Margin="9,2,9,5" Visibility="Collapsed"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </DockPanel>
  </Border>
</Window>
