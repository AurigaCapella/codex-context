<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../plugin/context-windows.cs" Link="ContextWindows.cs" />
    <Compile Include="../plugin/composer-anchor.cs" Link="ComposerAnchor.cs" />
    <Compile Include="../plugin/widget-mailbox.cs" Link="WidgetMailbox.cs" />
    <EmbeddedResource Include="../plugin/native.xaml" LogicalName="ContextWidget.Layout.xaml" />
  </ItemGroup>
</Project>
